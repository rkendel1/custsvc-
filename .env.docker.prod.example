# Production Docker deployment
APP_PORT=8080
COMPANY_NAME=KnowledgeOS

# Postgres (choose DATABASE_URL or PG* set)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# TLS
PGSSLMODE=require
PGSSL_STRICT_REQUIRE_CA=false
PGSSLROOTCERT=
DATABASE_SSL_CA=
DATABASE_SSL_CA_BASE64=
PGSSL_REJECT_UNAUTHORIZED=

# Startup safety
PG_REQUIRE_ON_STARTUP=true
PG_ALLOW_JSON_FALLBACK=false
PG_CONNECT_RETRIES=12
PG_CONNECT_RETRY_DELAY_MS=2000

# Required secrets
SOURCE_SECRET_KEY=replace-with-strong-random-secret
SOURCE_SECRET_KEY_VERSION=1
APP_PASSWORD=replace-with-strong-password
APP_AUTH_SECRET=replace-with-strong-random-secret
